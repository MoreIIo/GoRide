# Dépendances et fichiers compilés
node_modules/
dist/
target/
# Projets Android / iOS générés par Tauri : recréés sur GitHub à chaque compilation (android.yml)
src-tauri/gen/

# Journaux, fichiers système, éditeurs
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

